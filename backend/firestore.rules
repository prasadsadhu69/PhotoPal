rules_version = '2';

// The apps never write to Firestore directly. Every change goes through the
// Cloud Functions, which check the game rules and use the server's clock.
// Players may only read their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /ledger/{entry} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Push tokens are server-only
      match /devices/{device} {
        allow read, write: if false;
      }
    }

    // Shop, animals and tuning: readable by any signed-in player
    match /config/catalog {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
